{
  "$schema": "https://opencode.ai/config.json",
  "theme": "tokyonight",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
      },
      "models": {
        "gpt-oss:20b": {
          "name": "gpt-oss 20b",
        },
        "qwen3-coder:30b": {
          "name": "qwen3-coder:30b",
        },
      },
    },
  },
  "autoupdate": true,
}
